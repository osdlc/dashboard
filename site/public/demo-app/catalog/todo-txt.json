{"entries":[{"config_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"context":{"default":null,"description":"Only tasks with this `@context` (without the `@`).","type":["string","null"]},"limit":{"default":20,"description":"Rows shown.","format":"uint","minimum":0,"type":"integer"},"link":{"default":null,"description":"Makes each task a link: `{path}` is the file name, `{line}` the\ntask's line.","type":["string","null"]},"path":{"default":"~/todo.txt","description":"The todo.txt file. `~/` is expanded.","type":"string","x-path":true},"project":{"default":null,"description":"Only tasks with this `+project` (without the `+`).","type":["string","null"]},"show_future":{"default":false,"description":"Also list tasks whose `t:` threshold date is still ahead.","type":"boolean"}},"title":"Config","type":"object"},"default_size":"medium","demo":{"root":{"empty_text":"nothing to do","items":[{"action":null,"status":"error","subtitle":"overdue 1d · todo.txt","tags":["+finance","@phone"],"title":"Call the bank about the card"},{"action":null,"status":"warn","subtitle":"due today · todo.txt","tags":["+dashboard","@work"],"title":"Write the release notes"},{"action":null,"status":null,"subtitle":"due Fri · todo.txt","tags":["@errands"],"title":"Pick up the dry cleaning"},{"action":null,"status":null,"subtitle":"todo.txt","tags":["+home"],"title":"Look into standing desks"}],"type":"list"},"status":"warn","summary":"1 overdue · 1 due today · 4 open"},"description":"Open tasks from a todo.txt file: priorities, +project and @context tags, due: dates and t: thresholds. Overdue first.","id":"todo-txt","kind":"builtin","name":"todo.txt","requirements":{"binaries":[],"env":[],"hosts":[]},"source":"builtin","tags":["tasks","todo.txt","personal"],"version":"0.1.0","bundle":"personal"}]}