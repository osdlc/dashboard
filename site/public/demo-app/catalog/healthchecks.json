{"entries":[{"config_schema":{"additionalProperties":false,"properties":{"base_url":{"description":"The Healthchecks site, e.g. a self-hosted one. Default https://healthchecks.io.","type":"string"},"limit":{"description":"Checks listed. Default 20.","minimum":1,"type":"integer"},"tag":{"description":"Only checks with this tag.","type":["string","null"]},"token_command":{"description":"Command that prints the API key.","items":{"type":"string"},"type":["array","null"]},"token_env":{"description":"Variable holding the project's API key (Settings, API Access). A read-only key works, but then clicking a check opens the site's front page, not the check.. Default HEALTHCHECKS_API_KEY.","type":"string"}},"type":"object"},"default_size":"medium","demo":{"root":{"children":[{"children":[{"delta":null,"label":"Up","status":"ok","type":"stat","unit":null,"value":"1"},{"delta":null,"label":"Late","status":"warn","type":"stat","unit":null,"value":"1"},{"delta":null,"label":"Down","status":"error","type":"stat","unit":null,"value":"1"}],"type":"row"},{"empty_text":"no checks","items":[{"action":{"type":"open_url","url":"https://healthchecks.io/checks/5d3b6e2a-1f4c-4a9e-9b1d-0c2e7f8a6b31/details/"},"status":"error","subtitle":"down · last ping 1d ago","tags":["prod","backup"],"title":"Nightly backup"},{"action":{"type":"open_url","url":"https://healthchecks.io/checks/a1f0c9d8-3b2e-4c7a-8f61-5e4d3c2b1a09/details/"},"status":"warn","subtitle":"late · last ping 1d ago","tags":["prod"],"title":"Certificate renewal"},{"action":{"type":"open_url","url":"https://healthchecks.io/checks/0b9e8d7c-6a5f-4e3d-2c1b-0a9f8e7d6c5b/details/"},"status":"ok","subtitle":"running · last ping 1m ago","tags":["prod","worker"],"title":"Queue worker heartbeat"},{"action":{"type":"open_url","url":"https://healthchecks.io/checks/e4d3c2b1-a0f9-4e8d-9c7b-6a5f4e3d2c1b/details/"},"status":"unknown","subtitle":"new · never pinged","tags":[],"title":"new-check"},{"action":{"type":"open_url","url":"https://healthch