---
import Base from '../../layouts/Base.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import { blocks, blockShot, blockShotThemes, GROUPS, inlineCode, typeOf } from '../../lib/blocks'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const groups = GROUPS.map((g) => ({ ...g, blocks: blocks.filter((b) => b.group === g.id) }))
---

<Base
  title="Building blocks · dashboard"
  description="Every widget type a dashboard tile can show, each with a live example, and how they combine into bigger tiles."
>
  <SiteHeader here="blocks" />

  <main>
    <section class="head">
      <div class="wrap">
        <p class="label"><span class="n">blocks</span> building blocks</p>
        <h1>What every tile is made of.</h1>
        <p class="lede">
          A module sends a view: a tree of widgets. These are the widget types the dashboard draws, each with an
          example, and a few ways to put them together. Each page runs the example live in the web view, shows it in the
          terminal, and has its JSON to copy and every field it takes.
        </p>
        <p class="more">
          Writing your own widget? Start with <a href={`${base}tutorial/#5-your-own-widget`}>step 5 of the tutorial</a>.
          Finished widgets are in the <a href={`${base}widgets/`}>widget registry</a>.
        </p>

        <nav class="jump" aria-label="Sections">
          {
            groups.map((g) => (
              <div class="jump-group">
                <a class="jump-title" href={`#${g.id}`}>
                  {g.title} <span class="count">{g.blocks.length}</span>
                </a>
                {g.blocks.map((b) => (
                  <a href={`#${b.id}`}>{b.name}</a>
                ))}
              </div>
            ))
          }
        </nav>
      </div>
    </section>

    <div class="list">
      <div class="wrap">
        {
          groups.map((g) => (
            <section class="group" id={g.id} aria-labelledby={`${g.id}-title`}>
              <header class="group-head">
                <h2 id={`${g.id}-title`}>{g.title}</h2>
                <p>{g.blurb}</p>
              </header>
              <ul class="cards">
                {g.blocks.map((b) => (
                  <li class="card" id={b.id}>
                    <a href={`${base}blocks/${b.id}/`}>
                      <div class="thumb">
                        {blockShotThemes.map((theme) => {
                          const pic = blockShot(b, theme)
                          return (
                            pic && (
                              <img
                                src={base + pic.path}
                                width={pic.width}
                                height={pic.height}
                                style={`width: min(100%, ${Math.round(pic.width * 0.85)}px)`}
                                loading="lazy"
                                data-shows-theme={theme}
                                alt=""
                              />
                            )
                          )
                        })}
                      </div>
                      <div class="body">
                        <h3>
                          {b.name} <code>{typeOf(b)}</code>
                        </h3>
                        <p class="desc" set:html={inlineCode(b.description)} />
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </main>

  <SiteFooter />
</Base>

<style>
  .head {
    padding: 64px 0 28px;
  }

  h1 {
    font-size: clamp(30px, 4.2vw, 46px);
    max-width: 20ch;
    margin-bottom: 18px;
  }

  .more {
    margin: 16px 0 0;
    max-width: 62ch;
    color: var(--ink-2);
  }

  .jump {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 10px 28px;
    margin-top: 32px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .jump-group {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
  }

  .jump a {
    font: 13px var(--font-code);
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
  }

  .jump a:hover {
    color: var(--link);
  }

  .jump .jump-title {
    flex-basis: 100%;
    font: 600 14px var(--font-body);
    color: var(--ink);
  }

  .count {
    color: var(--faint);
    font: 12px var(--font-code);
  }

  .list {
    padding: 0 0 96px;
  }

  .group {
    padding-top: 40px;
    scroll-margin-top: 16px;
  }

  .group-head {
    margin-bottom: 22px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line-strong);
  }

  .group-head h2 {
    margin: 0;
    font-size: clamp(24px, 3vw, 32px);
  }

  .group-head p {
    margin: 8px 0 0;
    max-width: 70ch;
    color: var(--ink-2);
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 18px;
  }

  .card {
    scroll-margin-top: 80px;
  }

  .card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-raised);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.15s;
  }

  .card a:hover {
    border-color: var(--line-strong);
  }

  .card a:hover h3 {
    color: var(--link);
  }

  /* Examples in the page's own theme (see data-shows-theme in global.css). */
  .thumb {
    height: 170px;
    padding: 14px 14px 0;
    background: var(--bg-sunk);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  /* Scaled alike, so a small tile looks smaller than a wide one. */
  .thumb img {
    height: auto;
    object-fit: cover;
    object-position: top left;
    border-radius: 6px 6px 0 0;
  }

  .body {
    padding: 14px 16px 16px;
  }

  .card h3 {
    font-size: 15px;
    max-width: none;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .card h3 code {
    margin-left: 4px;
    font-size: 11.5px;
    font-weight: 400;
    color: var(--muted);
  }

  .desc {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .desc :global(code) {
    font-size: 0.85em;
  }
</style>
