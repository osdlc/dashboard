---
import { Code } from 'astro:components'
import Base from '../../layouts/Base.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SizesPreview from '../../components/SizesPreview.astro'
import {
  configExample,
  kindLabel,
  settings,
  shot,
  shotThemes,
  tuiTiles,
  untestedLive,
  widgets,
  type Widget,
} from '../../lib/registry'

export function getStaticPaths() {
  return widgets.map((w, i) => ({
    params: { id: w.id },
    props: { w, prev: widgets[i - 1], next: widgets[i + 1] },
  }))
}

interface Props {
  w: Widget
  prev: Widget | undefined
  next: Widget | undefined
}
const { w, prev, next } = Astro.props

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const repo = 'https://github.com/osdlc/dashboard'
const liveSrc = `demo-app/index.html?${new URLSearchParams({ mode: 'demo', fill: '', catalog: `catalog/${w.id}.json`, id: w.id, size: w.default_size })}`
const rows = settings(w)
const config = configExample(w)
const req = w.requirements
const needsNothing = !req.binaries.length && !req.env.length && !req.hosts.length
const sourceUrl = w.kind === 'plugin' && w.source !== 'bundled' ? `${repo}/tree/main/${w.source}` : null
---

<Base title={`${w.name} widget · dashboard`} description={w.description}>
  <SiteHeader here="widgets" />

  <main class="wrap page">
    <p class="crumbs"><a href={`${base}widgets/`}>Widgets</a> <span aria-hidden="true">/</span> {w.id}</p>

    <div class="intro">
      <div>
        <h1>{w.name}</h1>
        <p class="facts">
          <code>{w.id}</code>
          <span>{kindLabel(w)}</span>
          <span>v{w.version}</span>
          <span>default size {w.default_size}</span>
        </p>
        <p class="lede">{w.description}</p>
        {
          untestedLive(w) && (
            <p class="note">
              <strong>Untested live.</strong> Built from the service's API docs and a sample response; nobody has run it
              against the real service yet. The demo below is made up.
            </p>
          )
        }
        <ul class="tags" aria-label="Tags">
          {
            w.tags.map((t) => (
              <li>
                <a href={`${base}widgets/?tag=${encodeURIComponent(t)}`}>{t}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <SizesPreview
      name={w.name}
      defaultSize={w.default_size}
      liveSrc={liveSrc}
      shot={(theme, size) => shot(w, theme, size)}
      shotThemes={shotThemes}
      tui={tuiTiles(w)}
      summary={w.demo.summary}
    />

    <div class="cols">
      <section>
        <h2>Add it</h2>
        <div class="window">
          <div class="window-bar">
            <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="title">config.yaml</span>
            <button type="button" class="copy" data-copy={config}>Copy</button>
          </div>
          <Code code={config} lang="yaml" theme="vitesse-dark" class="code" />
        </div>
        <p class="hint">
          {
            w.kind === 'plugin' && w.source !== 'bundled' ? (
              <>
                A plugin package: put its folder in <code>plugins/{w.id}/</code> next to your config, or in{' '}
                <code>~/.local/share/dashboard/plugins/</code>.
              </>
            ) : w.source === 'bundled' ? (
              <>Bundled into the dashboard binary; nothing to install.</>
            ) : (
              <>Built in; nothing to install.</>
            )
          }{' '}
          Or add it from the catalog in the web view's editor; <code>dashboard widgets {w.id}</code> lists it in a terminal.
        </p>
      </section>

      <section>
        <h2>Needs</h2>
        {
          needsNothing ? (
            <p class="plain">Nothing: no programs, tokens or network.</p>
          ) : (
            <dl class="needs">
              {req.binaries.length > 0 && (
                <>
                  <dt>Programs</dt>
                  <dd>{req.binaries.map((b) => <code>{b}</code>)}</dd>
                </>
              )}
              {req.env.length > 0 && (
                <>
                  <dt>Environment</dt>
                  <dd>{req.env.map((e) => <code>{e}</code>)}</dd>
                </>
              )}
              {req.hosts.length > 0 && (
                <>
                  <dt>Calls</dt>
                  <dd>{req.hosts.map((h) => <code>{h}</code>)}</dd>
                </>
              )}
            </dl>
          )
        }
        {
          req.env.length > 0 && (
            <p class="hint">
              Tokens come from an environment variable or a command (<code>token_env</code>,{' '}
              <code>token_command</code>), never from the config file.
            </p>
          )
        }
        {
          sourceUrl && (
            <p class="hint">
              Source: <a href={sourceUrl}>{w.source}</a>
            </p>
          )
        }
      </section>
    </div>

    <section class="settings">
      <h2>Settings</h2>
      {
        rows.length ? (
          <div class="table">
            <table>
              <thead>
                <tr>
                  <th scope="col">Key</th>
                  <th scope="col">Type</th>
                  <th scope="col">Default</th>
                  <th scope="col">What it does</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr>
                    <th scope="row">
                      <code>{r.key}</code>
                      {r.required && <span class="req">required</span>}
                    </th>
                    <td class="type">{r.type}</td>
                    <td class="default">{r.default && <code>{r.default}</code>}</td>
                    <td class="what">{r.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="plain">None besides the usual ones every module has (refresh and demo; size is set on the tile).</p>
        )
      }
    </section>

    <nav class="pager" aria-label="Other widgets">
      {prev ? <a href={`${base}widgets/${prev.id}/`}>← {prev.name}</a> : <span />}
      {next && <a href={`${base}widgets/${next.id}/`}>{next.name} →</a>}
    </nav>
  </main>

  <SiteFooter />

  <script>
    import { wireCopyButtons } from '../../lib/copy'
    wireCopyButtons()
  </script>
</Base>

<style>
  .page {
    padding-top: 40px;
    padding-bottom: 96px;
  }

  .crumbs {
    margin: 0 0 28px;
    font: 13px var(--font-code);
    color: var(--muted);
  }

  .crumbs span {
    margin: 0 6px;
    color: var(--faint);
  }

  h1 {
    font-size: clamp(30px, 4.2vw, 46px);
    margin-bottom: 14px;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0 0 18px;
    font: 13px var(--font-code);
    color: var(--muted);
  }

  .note {
    max-width: 62ch;
    margin: 18px 0 0;
    padding: 10px 14px;
    border-left: 3px solid var(--warn);
    background: var(--bg-raised);
    font-size: 15px;
    color: var(--ink-2);
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 20px 0 0;
    padding: 0;
  }

  .tags a {
    display: inline-block;
    padding: 3px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font: 12.5px/1.4 var(--font-code);
    color: var(--ink-2);
    text-decoration: none;
  }

  .tags a:hover {
    border-color: var(--accent);
    color: var(--ink);
  }

  h2 {
    font-size: 20px;
    margin: 0 0 16px;
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 40px;
    margin-top: 56px;
  }

  @media (max-width: 860px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .copy {
    flex: none;
    height: 22px;
    padding: 0 8px;
    border: 1px solid var(--term-line);
    border-radius: 5px;
    background: none;
    color: var(--term-dim);
    font: 11.5px var(--font-code);
    cursor: pointer;
  }

  .copy:hover {
    color: var(--term-ink);
  }

  .hint,
  .plain {
    margin: 14px 0 0;
    font-size: 14.5px;
    color: var(--muted);
  }

  .plain {
    margin-top: 0;
    color: var(--ink-2);
  }

  .needs {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 10px 18px;
    margin: 0;
  }

  .needs dt {
    font: 13px/1.9 var(--font-code);
    color: var(--muted);
  }

  /* python3>=3.9 stays as typed, not a ≥ ligature. */
  .needs code {
    font-variant-ligatures: none;
  }

  .needs dd {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
  }

  .settings {
    margin-top: 56px;
  }

  .table {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
  }

  th,
  td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  tbody tr:last-child > * {
    border-bottom: 0;
  }

  thead th {
    background: var(--bg-sunk);
    font: 500 12px var(--font-code);
    color: var(--muted);
    text-transform: lowercase;
  }

  tbody th {
    font-weight: 400;
    white-space: nowrap;
  }

  .req {
    display: block;
    margin-top: 2px;
    font: 11px var(--font-code);
    color: var(--warn);
  }

  .type {
    font: 12.5px var(--font-code);
    color: var(--ink-2);
    min-width: 9ch;
  }

  .default {
    min-width: 14ch;
  }

  td code {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .what {
    color: var(--ink-2);
    min-width: 24ch;
    white-space: pre-line;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font: 14px var(--font-code);
  }

  /* Shiki output: keep the frame's background and our sizing. */
  :global(.astro-code.code) {
    background-color: var(--term-bg) !important;
  }
</style>
